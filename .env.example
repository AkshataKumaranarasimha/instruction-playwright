# Browser / run mode
BASE_URL=https://www.google.com
SMOKE_BASE_URL=http://127.0.0.1:4173/
SMOKE_PORT=4173
# Local Google demo uses system Chrome; CI leaves this empty (Playwright Chromium).
BROWSER_CHANNEL=chrome
HEADLESS=true
# HEADLESS=false
SLOW_MO=0
# Persistent profile helps Google locally; CI sets false.
USE_PERSISTENT_PROFILE=true
PERSISTENT_PROFILE_DIR=.auth/chrome-profile

# Timeouts (ms)
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=15000
TEST_TIMEOUT=60000
